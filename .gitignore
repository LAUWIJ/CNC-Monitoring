# Local / site-specific - never in the repository
config.toml
pi/pi_settings.local.bat
data/
backups/
certs/
__pycache__/
*.pyc
*.zip
.pytest_cache/

# network recordings (Wireshark) contain real programs and addresses
*.pcapng
*.pcap

# FANUC FOCAS libraries are licensed - each site gets the Windows ones from FANUC / its machine builder.
# Exception: the Linux ARM library for the Raspberry Pi, which FANUC allows to be redistributed freely
# (see NOTICE.md).
FOCAS/*
!FOCAS/README.txt
!FOCAS/libfwlib32-linux-armv7.so.1.0.5
